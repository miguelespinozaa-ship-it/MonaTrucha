{
  "name": "sitio-anime",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "ASTRO_TELEMETRY_DISABLED=1 astro dev --host 0.0.0.0",
    "build": "node scripts/refresh-metadata.mjs && ASTRO_TELEMETRY_DISABLED=1 astro build && node scripts/security-headers.mjs",
    "preview": "ASTRO_TELEMETRY_DISABLED=1 astro preview --host 0.0.0.0",
    "check": "ASTRO_TELEMETRY_DISABLED=1 astro check",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "verify:videos": "node scripts/verify-videos.mjs",
    "test": "playwright test",
    "test:unit": "node --test tests/*.test.mjs",
    "perf": "node scripts/performance.mjs",
    "predev": "node scripts/refresh-metadata.mjs",
    "test:ads": "node scripts/test-ads.mjs"
  },
  "dependencies": {
    "@astrojs/sitemap": "^3.7.4",
    "@fontsource-variable/dm-sans": "^5.3.0",
    "@fontsource-variable/outfit": "^5.3.0",
    "astro": "^7.3.8",
    "gray-matter": "^4.0.3",
    "marked": "^18.1.1",
    "sanitize-html": "^2.18.0",
    "sharp": "^0.35.5"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@axe-core/playwright": "^4.13.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.0",
    "@types/sanitize-html": "^2.16.2",
    "eslint": "^10.12.0",
    "eslint-plugin-astro": "^3.2.1",
    "lighthouse": "^13.5.0",
    "prettier": "^3.9.10",
    "prettier-plugin-astro": "^1.1.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.2"
  }
}
