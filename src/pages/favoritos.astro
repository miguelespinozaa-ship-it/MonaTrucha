---
import BaseLayout from '../layouts/BaseLayout.astro';
import SeriesCard from '../components/SeriesCard.astro';
import { getSeries } from '../data/catalog';
const series = await getSeries();
---

<BaseLayout title="Mi lista" noindex>
  <div class="container">
    <div class="page-heading">
      <p class="eyebrow">Un pequeño universo propio</p>
      <h1>Historias para volver.</h1>
      <p>
        Tus favoritos viven en este navegador. Sin cuentas, sin sincronización.
      </p>
    </div>
    <div class="catalog-grid" id="favorites-list">
      {series.map((s) => (
        <SeriesCard series={s} headingLevel="h2" />
      ))}
    </div>
    <div class="empty-state" id="favorites-empty" hidden>
      <h2>Tu lista empieza con un descubrimiento.</h2>
      <p>Pulsa el corazón de cualquier ficha para guardarla aquí.</p>
      <a class="button button-primary" href="/catalogo/">
        Explorar historias
      </a>
    </div>
    <noscript>
      <p class="notice">
        Activa JavaScript para consultar y guardar tu lista local. Las fichas de
        arriba permiten seguir explorando.
      </p>
    </noscript>
  </div>
</BaseLayout>
