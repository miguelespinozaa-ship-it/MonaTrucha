---
import { Image } from 'astro:assets';
import { marked, type Token } from 'marked';
import sanitize from 'sanitize-html';
import BaseLayout from '../../layouts/BaseLayout.astro';
import AdSlot from '../../components/AdSlot.astro';
import { getArticles } from '../../data/catalog';
import { site } from '../../data/site';
export async function getStaticPaths() {
  return (await getArticles()).map((article) => ({
    params: { id: article.id },
    props: { article },
  }));
}
const { article } = Astro.props;
const tokens = marked.lexer(article.body || '');
const chunks: string[] = [];
let group: Token[] = [];
let paragraphs = 0;
for (const token of tokens) {
  group.push(token);
  if (token.type === 'paragraph' && ++paragraphs % 3 === 0) {
    chunks.push(sanitize(marked.parser(group)));
    group = [];
  }
}
if (group.length) chunks.push(sanitize(marked.parser(group)));
const schema = {
  '@type': 'Article',
  headline: article.data.title,
  description: article.data.description,
  datePublished: article.data.date.toISOString(),
  dateModified: article.data.date.toISOString(),
  image: new URL(article.data.cover.src, site.url).href,
  author: { '@type': 'Organization', name: article.data.author, url: site.url },
  publisher: { '@type': 'Organization', name: site.name, url: site.url },
};
---

<BaseLayout
  title={article.data.title}
  description={article.data.description}
  image={article.data.cover.src}
  type="article"
  schema={schema}
  noindex={article.data.placeholder}
>
  <article class="container article-layout">
    <nav class="breadcrumbs" aria-label="Ruta de navegación">
      <a href="/">Inicio</a>
      <span aria-hidden="true">/</span>
      <a href="/articulos/">Historias</a>
      <span aria-hidden="true">/</span>
      <span aria-current="page">{article.data.category}</span>
    </nav>
    <header class="article-heading">
      <p class="eyebrow">{article.data.category}</p>
      <h1>{article.data.title}</h1>
      <p>{article.data.description}</p>
      <div class="article-meta">
        <span>{article.data.author}</span>
        <span>·</span>
        <time datetime={article.data.date.toISOString()}>
          {article.data.date.toLocaleDateString('es', {
            timeZone: 'UTC',
            day: 'numeric',
            month: 'long',
            year: 'numeric',
          })}
        </time>
        <span>·</span>
        <span>{article.data.minutes} min de lectura</span>
      </div>
    </header>
    <Image
      class="article-cover"
      src={article.data.cover}
      alt="Ilustración original para el artículo de demostración"
      width={1200}
      height={525}
      format="webp"
      loading="eager"
    />
    <div class="content-with-sidebar">
      <div class="prose">
        {article.data.placeholder && (
          <p class="notice">
            Artículo de demostración. Las series mencionadas como ficticias no
            son producciones reales.
          </p>
        )}
        {chunks.map((html, i) => (
          <>
            <div set:html={html} />
            {i < chunks.length - 1 && (
              <AdSlot position="article" format="in-article" />
            )}
          </>
        ))}
        <p>
          <a href="/articulos/">← Volver a todas las historias</a>
        </p>
      </div>
      <aside class="desktop-sidebar">
        <div class="sidebar-box">
          <p class="eyebrow">Tu siguiente paso</p>
          <h2>Encuentra tu próxima historia.</h2>
          <p>Explora el catálogo por género y guarda tus descubrimientos.</p>
          <a class="button button-secondary" href="/catalogo/">
            Explorar catálogo
          </a>
          <AdSlot position="sidebar" format="vertical" />
        </div>
      </aside>
    </div>
  </article>
</BaseLayout>
